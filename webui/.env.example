# ----- iron-session encrypted-cookie secret -----
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters

# ----- User accounts (comma-separated) -----
# Format: username:password:role  where role is admin | moderator | viewer
USERS=admin:changeme:admin,parent:simplepass:moderator

# ----- Shared bearer token for host-api + bds-api -----
# Must match `apiToken` in /etc/minecraftlab/worlds.json on the Proxmox host,
# and the BDS_API_TOKEN env var on each world container's bds-api service.
BDS_API_TOKEN=change-this-to-a-random-string

# ----- Where the host-api is running -----
# Usually the Proxmox host's LAN IP. Default port 8090.
HOST_API_URL=http://192.168.1.1:8090

# ----- CurseForge API key (optional, but required for the addon browser) -----
# Get a free key at https://console.curseforge.com/
CURSEFORGE_API=
